[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-edgesync
Exec=harbour-edgesync
Name=Edge Sync

[X-Sailjail]
OrganizationName=io.github.jarnose
ApplicationName=edgesync
# Bluetooth: the Edge, through BlueZ over the system bus.
# Documents: where "Save as GPX", "Save the FIT file" and the saved log go
# (~/Documents/EdgeSync). Nothing else outside the app's own data folder is touched.
# Downloads: where a FIT file to import is often saved.
# Internet: (1) the optional base map under the route (off by default), which
# fetches map tiles for the area of a ride from the tile server in Settings, and
# (2) Garmin Connect, only after the user signs in there: downloading rides from it
# and sending rides to it. Nothing is sent anywhere else, and nothing to Garmin
# unless the user asks.
# Secrets: the Garmin Connect sign-in tokens (never the password) in the
# Sailfish Secrets vault.
Permissions=Bluetooth;Documents;Downloads;Internet;Secrets
